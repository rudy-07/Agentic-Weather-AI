# Environment configuration template
# Copy this file to .env and configure your paths and keys.

# Path to the local LLM .gguf model file.
# E.g., C:\Users\YourUser\Downloads\models\zephyr-7b-beta.Q4_K_M.gguf
MODEL_PATH="your_model_path_here.gguf"

# HuggingFace token for gated models (required for finetune.py if using Gemma/Llama)
HUGGING_FACE_HUB_TOKEN="your_hf_token_here"

# Mausamgram credentials. Keep real values only in .env or HPC environment variables.
MAUSAMGRAM_USER="your_mausamgram_user"
MAUSAMGRAM_KEY="your_mausamgram_key"

# Override these only if the Mausamgram PHP demo scripts use different JSON field names.
MAUSAMGRAM_LAT_FIELD="lat"
MAUSAMGRAM_LON_FIELD="lon"
MAUSAMGRAM_HOURLY_FIELD="hourly"

# Optional model cycle for hourly APIs, e.g. 2023122600 or 2023122612.
# Leave blank to let Mausamgram use its default/latest cycle.
MAUSAMGRAM_DATE=""
MAUSAMGRAM_DATE_FIELD="date"
